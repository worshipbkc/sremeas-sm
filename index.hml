<!DOCTYPE html>
<html lang="km">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ចម្រៀងសរសើរដំកើងព្រះ</title>
    <link href="https://fonts.googleapis.com/css2?family=Kantumruy+Pro:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Kantumruy Pro', sans-serif;
        }

        body {
            background-color: #121212;
            color: #ffffff;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        /* Phone Screen Container */
        .phone-container {
            width: 100%;
            max-width: 412px;
            height: 844px;
            background: linear-gradient(135deg, #2c1605 0%, #1a0d03 100%);
            border-radius: 40px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.6);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
            border: 8px solid #333;
        }

        /* Header Style */
        .app-header {
            padding: 20px 16px 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(0, 0, 0, 0.2);
        }

        .app-title {
            font-size: 18px;
            font-weight: 700;
            color: #ffb74d;
        }

        .search-icon {
            font-size: 18px;
            color: #fff;
            cursor: pointer;
        }

        /* Content Grid (Picture Cards) */
        .content-scroll {
            flex: 1;
            overflow-y: auto;
            padding: 12px 16px;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            padding-bottom: 20px;
        }

        .content-scroll::-webkit-scrollbar {
            width: 4px;
        }

        .content-scroll::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.2);
            border-radius: 4px;
        }

        .picture-card {
            background: rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: transform 0.2s;
            cursor: pointer;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .picture-card:active {
            transform: scale(0.96);
        }

        .card-img-container {
            position: relative;
            width: 100%;
            height: 90px;
        }

        .card-img-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .play-btn-overlay {
            position: absolute;
            bottom: 8px;
            right: 8px;
            background: rgba(0, 0, 0, 0.6);
            border-radius: 50%;
            width: 24px;
            height: 24px;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #ffb74d;
            font-size: 10px;
        }

        .card-info {
            padding: 8px;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .card-title {
            font-size: 12px;
            font-weight: 600;
            color: #fff;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .card-subtitle {
            font-size: 10px;
            color: #b0bec5;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Bottom Navigation Menu (4 items) */
        .bottom-nav {
            height: 65px;
            background: rgba(20, 10, 2, 0.95);
            backdrop-filter: blur(10px);
            display: flex;
            justify-content: space-around;
            align-items: center;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: #9e9e9e;
            text-decoration: none;
            font-size: 11px;
            gap: 4px;
            cursor: pointer;
            transition: color 0.2s;
        }

        .nav-item i {
            font-size: 18px;
        }

        .nav-item.active, .nav-item:hover {
            color: #ffb74d;
        }
    </style>
</head>
<body>

    <div class="phone-container">
        <!-- ក្បាលទំព័រ (Header) -->
        <div class="app-header">
            <div class="app-title">ចម្រៀងសរសើរដំកើងព្រះ</div>
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
        </div>

        <!-- សន្លឹករូបភាពចម្រៀង (Picture Cards Grid) -->
        <div class="content-scroll">
            <!-- Card 1 -->
            <div class="picture-card">
                <div class="card-img-container">
                    <img src="https://images.unsplash.com/photo-1519817650390-64a93db51149?w=300" alt="Card Image">
                    <div class="play-btn-overlay"><i class="fa-solid fa-play"></i></div>
                </div>
                <div class="card-info">
                    <span class="card-title">ព្រះយេស៊ូវជាជីវិត</span>
                    <span class="card-subtitle">Worship Leader</span>
                </div>
            </div>

            <!-- Card 2 -->
            <div class="picture-card">
                <div class="card-img-container">
                    <img src="https://images.unsplash.com/photo-1438232992991-995b7058bbb3?w=300" alt="Card Image">
                    <div class="play-btn-overlay"><i class="fa-solid fa-play"></i></div>
                </div>
                <div class="card-info">
                    <span class="card-title">ជំនឿនិតជីដ</span>
                    <span class="card-subtitle">New Psalms Choir</span>
                </div>
            </div>

            <!-- Card 3 -->
            <div class="picture-card">
                <div class="card-img-container">
                    <img src="https://images.unsplash.com/photo-1507676184212-d03ab07a01bf?w=300" alt="Card Image">
                    <div class="play-btn-overlay"><i class="fa-solid fa-play"></i></div>
                </div>
                <div class="card-info">
                    <span class="card-title">ព្រះជាម្ចាស់ដ៏ធំ</span>
                    <span class="card-subtitle">Praise Team</span>
                </div>
            </div>

            <!-- Card 4 -->
            <div class="picture-card">
                <div class="card-img-container">
                    <img src="https://images.unsplash.com/photo-1470225620780-dba8ba36b745?w=300" alt="Card Image">
                    <div class="play-btn-overlay"><i class="fa-solid fa-play"></i></div>
                </div>
                <div class="card-info">
                    <span class="card-title">ដំណើរជាមួយព្រះ</span>
                    <span class="card-subtitle">Journey with God</span>
                </div>
            </div>

            <!-- Card 5 -->
            <div class="picture-card">
                <div class="card-img-container">
                    <img src="https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=300" alt="Card Image">
                    <div class="play-btn-overlay"><i class="fa-solid fa-play"></i></div>
                </div>
                <div class="card-info">
                    <span class="card-title">អំណរក្នុងព្រះអង្គ</span>
                    <span class="card-subtitle">Youth Choir</span>
                </div>
            </div>

            <!-- Card 6 -->
            <div class="picture-card">
                <div class="card-img-container">
                    <img src="https://images.unsplash.com/photo-1459749411175-04bf5292ceea?w=300" alt="Card Image">
                    <div class="play-btn-overlay"><i class="fa-solid fa-play"></i></div>
                </div>
                <div class="card-info">
                    <span class="card-title">សន្តិភាពក្នុងព្រះគ្រីស្ទ</span>
                    <span class="card-subtitle">Peace in Christ</span>
                </div>
            </div>
        </div>

        <!-- មឺនុយទាំង ៤ ខាងក្រោម (Bottom Menu: ចម្រៀង អាល់ប៊ុម Playlist Profile) -->
        <div class="bottom-nav">
            <a class="nav-item active">
                <i class="fa-solid fa-music"></i>
                <span>ចម្រៀង</span>
            </a>
            <a class="nav-item">
                <i class="fa-solid fa-compact-disc"></i>
                <span>អាល់ប៊ុម</span>
            </a>
            <a class="nav-item">
                <i class="fa-solid fa-list-ul"></i>
                <span>Playlist</span>
            </a>
            <a class="nav-item">
                <i class="fa-solid fa-user"></i>
                <span>Profile</span>
            </a>
        </div>
    </div>

</body>
</html>
